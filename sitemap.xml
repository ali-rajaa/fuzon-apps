{%- comment -%}
  Every HTML/Markdown page except the 404 and anything with noindex
  (placeholders are noindex, so only built pages are listed). URLs are
  extensionless, the same form as every canonical. lastmod is only ever a
  real date from front matter (updated, else last_updated, else date),
  never the build time. The empty front matter fence above is required,
  or Jekyll copies this file unrendered.
{%- endcomment -%}
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- assign _pages = site.pages | sort: "url" -%}
{%- for p in _pages %}
  {%- assign _ext = p.name | split: "." | last -%}
  {%- unless _ext == "html" or _ext == "md" -%}{%- continue -%}{%- endunless -%}
  {%- if p.url == "/404.html" or p.noindex -%}{%- continue -%}{%- endif -%}
  {%- assign _loc = p.url | replace: "/index.html", "/" | replace: ".html", "" -%}
  {%- assign _mod = p.updated | default: p.last_updated | default: p.date -%}
  <url>
    <loc>{{ _loc | absolute_url }}</loc>
    {%- if _mod %}
    <lastmod>{{ _mod | date: "%Y-%m-%d" }}</lastmod>
    {%- endif %}
  </url>
{%- endfor %}
</urlset>
