---
---
{
  "name": "Fuzon Apps",
  "short_name": "Fuzon Apps",
  "icons": [
    {%- assign _v = site.time | date: "%s" %}
    { "src": "{{ '/assets/icons/icon-192.png' | relative_url }}?v={{ _v }}", "sizes": "192x192", "type": "image/png" },
    { "src": "{{ '/assets/icons/icon-512.png' | relative_url }}?v={{ _v }}", "sizes": "512x512", "type": "image/png" }
  ],
  "theme_color": "#ffffff",
  "background_color": "#ffffff",
  "display": "browser"
}
